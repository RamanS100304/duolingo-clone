# Where the SQLite file lives. On Railway, mount a volume at /data and use the 4-slash form:
#   DATABASE_URL=sqlite:////data/duolingo.db
DATABASE_URL=sqlite:///./duolingo.db
# Frontend origin(s) allowed by CORS, comma-separated ("*" = any)
CORS_ORIGINS=*
# Signs match-pairs tokens; any long random string
SECRET_KEY=change-me
# Settings -> "Testing tools" (simulate a day / reset demo). Keep true for reviewers.
ENABLE_DEV_TOOLS=true
# Day boundaries until the browser reports the learner's own time zone
DEFAULT_TIMEZONE=Asia/Kolkata
